{
  "name": "dsh-desktop-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Built-in Live2D desktop companions",
  "main": "src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/prepare-dependencies.mjs && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:electron": "node scripts/electron-smoke.mjs",
    "test:conversation": "node scripts/conversation-smoke.mjs"
  },
  "dependencies": {
    "json5": "2.2.3",
    "pinyin-pro": "3.27.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "ws": "8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT"
}
